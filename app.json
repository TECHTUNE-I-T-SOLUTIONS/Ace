{
    "expo":  {
                 "name":  "ACE",
                 "slug":  "ace",
                 "scheme":  "ace",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/logo.png",
                 "userInterfaceStyle":  "dark",
                 "splash":  {
                                "image":  "./assets/logo.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#0A2342"
                            },
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "plugins":  [
                                 "expo-router",
                                 "@react-native-community/datetimepicker",
                                 [
                                     "expo-notifications",
                                     {
                                         "icon":  "./assets/logo.png",
                                         "color":  "#214FCE",
                                         "sounds":  [
                                                        "./assets/notifications.wav"
                                                    ]
                                     }
                                 ]
                             ],
                 "extra":  {
                               "router":  {
                                              "origin":  false
                                          },
                               "eas":  {
                                           "projectId":  "82fc60f5-f42e-4407-9e3b-4f2f67a45c96"
                                       }
                           },
                 "android":  {
                                 "package":  "com.ace.mobile",
                                 "versionCode":  1,
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/logo.png",
                                                      "backgroundColor":  "#0A2342"
                                                  },
                                 "permissions":  [
                                                     "RECEIVE_BOOT_COMPLETED",
                                                     "VIBRATE",
                                                     "WAKE_LOCK",
                                                     "POST_NOTIFICATIONS"
                                                 ]
                             },
                 "ios":  {
                             "bundleIdentifier":  "com.ace.mobile",
                             "supportsTablet":  true,
                             "infoPlist":  {
                                               "UIBackgroundModes":  [
                                                                         "remote-notification"
                                                                     ]
                                           }
                         },
                 "owner":  "princetechtune",
                 "cli":  {
                             "appVersionSource":  "remote"
                         }
             },
    "updates":  {
                    "enabled":  false
                }
}
